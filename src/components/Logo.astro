---
/*
 * Official Impact Axis logo (horizontal lockup).
 * Source files live in brand-source/logo/. The files in src/assets/brand/ are
 * the same artwork trimmed to its edges on a transparent background; the
 * artwork itself is unchanged. Swap to SVG when a vector master is supplied.
 */
import { Image } from 'astro:assets';
import lockupBlack from '../assets/brand/impact-axis-lockup-black.png';
import lockupBlue from '../assets/brand/impact-axis-lockup-blue.png';

interface Props {
  /**
   * Black is the header default: it keeps the white header restrained beside
   * the navy navigation. The blue (#2024D4) colour lockup is also supplied.
   */
  variant?: 'blue' | 'black';
}

const { variant = 'black' } = Astro.props;
const src = variant === 'black' ? lockupBlack : lockupBlue;
const isHome = Astro.url.pathname === '/';
---

<a href="/" class="logo" aria-current={isHome ? 'page' : undefined} data-logo>
  <Image
    src={src}
    alt="Impact Axis"
    width={128}
    densities={[1, 2, 3]}
    loading="eager"
    decoding="async"
    class="logo__image"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: var(--radius-xs);
  }

  .logo__image {
    width: auto;
    height: 2.5rem; /* 40px tall, about 107px wide */
  }

  @media (min-width: 75rem) {
    .logo__image {
      height: 3rem; /* 48px tall, about 128px wide */
    }
  }
</style>
