---
import type { HTMLAttributes } from 'astro/types';
import { currentState } from '../data/navigation';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'bar' | 'panel';
};

const { href, variant = 'bar', class: className, ...rest } = Astro.props;
const current = currentState(href, Astro.url.pathname);
---

<a
  href={href}
  class:list={['nav-link', `nav-link--${variant}`, className]}
  aria-current={current}
  {...rest}
>
  <span class="nav-link__text"><slot /></span>
</a>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-link__text {
    position: relative;
  }

  /* Desktop bar: navy text with a short underline that draws in on hover. */
  .nav-link--bar {
    min-height: 2.75rem;
    color: var(--color-navy);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: 0.005em;
    white-space: nowrap;
  }

  .nav-link--bar .nav-link__text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.375rem;
    height: var(--border-strong);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-link--bar:hover .nav-link__text::after,
  .nav-link--bar[aria-current] .nav-link__text::after {
    transform: scaleX(1);
  }

  /* Mobile panel: large white links, current page in yellow. */
  .nav-link--panel {
    display: flex;
    width: 100%;
    min-height: 3.5rem;
    padding-block: var(--space-xs);
    color: var(--color-white);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .nav-link--panel .nav-link__text {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: var(--border-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .nav-link--panel:hover .nav-link__text {
    text-decoration-color: currentColor;
  }

  .nav-link--panel[aria-current] {
    color: var(--color-yellow);
  }
</style>
