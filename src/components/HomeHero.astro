---
/*
 * Homepage hero: "Opening the space between education and opportunity."
 *
 * Three planes only:
 *   1. Navy canvas and typography.
 *   2. The contextual programme photograph, inside a window that bleeds to the
 *      viewport edge.
 *   3. A precisely aligned cutout band of the same participant, whose crown
 *      rises above the window's top edge.
 *
 * Planes 2 and 3 share one coordinate system (the "stage"): a fixed crop of
 * the original photograph. The stage is sized like `object-fit: cover`
 * against the frame using container query units, so the cutout stays
 * registered with the photograph at every width.
 *
 * Photograph: GWF Photos / IDT-46.jpg (Goodwill Fellowship 2026).
 * See brand-source/photography/README.md for provenance and edits.
 */
import { Image, Picture } from 'astro:assets';
import Button from './Button.astro';
import foreground from '../assets/hero/idt-46-foreground.png';
import stage from '../assets/hero/idt-46-stage.jpg';

const copy = {
  eyebrow: 'NONPROFIT YOUTH WORKFORCE DEVELOPMENT IN CAMEROON',
  headline: 'Building the bridge from education to meaningful work.',
  // Intentional line breaks for the wide layout; the last line takes the accent.
  lines: ['Building the bridge', 'from education to', 'meaningful work.'],
  lede: 'Impact Axis is a Cameroon-based nonprofit helping young people build the practical skills, experience and networks they need to access meaningful and dignified work. We do this through experiential learning, mentorship and applied projects.',
  primary: { label: 'Partner with us', href: '/work-with-us' },
  secondary: { label: 'Explore our work', href: '/our-work' },
  path: ['Learn', 'Apply', 'Connect'],
};

const photoAlt =
  'A Goodwill Fellowship participant in a 2026 GWF T-shirt speaks while holding her notes, with other fellows behind her.';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">{copy.eyebrow}</p>

      <h1 id="hero-title" class="hero__title">
        <span class="visually-hidden">{copy.headline}</span>
        <span class="hero__lines" aria-hidden="true">
          {
            copy.lines.map((line, i) => (
              <>
                {i > 0 && ' '}
                <span class="hero__line" style={`--i: ${i}`}>
                  <span class:list={['hero__line-inner', i === copy.lines.length - 1 && 'hero__accent']}>
                    {line}
                  </span>
                </span>
              </>
            ))
          }
        </span>
      </h1>

      <p class="hero__lede">{copy.lede}</p>

      <div class="hero__actions">
        <Button href={copy.secondary.href} variant="outline-light" size="large" arrow>
          {copy.secondary.label}
        </Button>
        <Button href={copy.primary.href} size="large" arrow>
          {copy.primary.label}
        </Button>
      </div>
    </div>

    <figure class="hero__media">
      <div class="hero__window">
        <div class="hero__stage">
          <Picture
            src={stage}
            alt={photoAlt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600, 2000, 2560]}
            width={2560}
            sizes="(min-width: 64rem) 68vw, 140vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero__photo"
          />
        </div>
      </div>
      <div class="hero__stage hero__stage--front" aria-hidden="true">
        <Image
          src={foreground}
          alt=""
          widths={[320, 640, 960, 1239]}
          sizes="(min-width: 64rem) 19vw, 38vw"
          loading="eager"
          decoding="async"
          class="hero__cutout"
        />
      </div>
    </figure>

    <script is:inline>
      // Start the photographic reveal only once the photograph can be seen.
      // Always resolves: on load, on error, or after a short safety timeout.
      (function () {
        var hero = document.currentScript && document.currentScript.closest('.hero');
        if (!hero) return;
        var ready = function () {
          hero.setAttribute('data-photo-ready', '');
        };
        try {
          var img = hero.querySelector('.hero__photo');
          if (!img || img.complete) return ready();
          img.addEventListener('load', ready, { once: true });
          img.addEventListener('error', ready, { once: true });
          setTimeout(ready, 2500);
        } catch (e) {
          ready();
        }
      })();
    </script>

    <ol class="hero__path" aria-label="Our approach">
      {
        copy.path.map((step, i) => (
          <li class="hero__step" style={`--i: ${i}`}>
            {step}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    /* Stage geometry: crop of the original, and the cutout band within it. */
    --stage-ar: 1.3419; /* 4600 / 3428 */
    --stage-anchor-x: 0.535; /* horizontal centre of the participant */
    --front-left: 39.239%;
    --front-top: -11.669%;
    --front-width: 26.935%;
    --front-line: 48.8%; /* the frame line, measured down the cutout band */

    position: relative;
    overflow: clip;
    background: var(--color-navy);
    color: var(--color-text-on-dark);
    --focus-color: var(--color-yellow);
  }

  /* ---------- Layout: mobile first ---------- */

  .hero__grid {
    display: grid;
    grid-template-columns: [full-start] var(--gutter) [content-start] minmax(0, 1fr) [content-end] var(--gutter) [full-end];
    row-gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero__copy {
    grid-column: content;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero__eyebrow {
    max-width: 30ch;
    color: var(--color-muted-on-dark);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    line-height: 1.5;
  }

  .hero__title {
    margin-top: var(--space-m);
    color: var(--color-white);
    font-size: clamp(2.125rem, 1.35rem + 3.6vw, 3.25rem);
    font-weight: var(--weight-semibold);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  /* On narrow screens the headline wraps naturally. */
  .hero__line,
  .hero__line-inner {
    display: inline;
  }

  .hero__accent {
    color: var(--color-yellow);
  }

  .hero__lede {
    max-width: 36rem;
    margin-top: var(--space-m);
    color: var(--color-muted-on-dark);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  /* Photograph: bleeds to the right edge, keeps the left gutter. */
  .hero__media {
    grid-column: content-start / full-end;
    position: relative;
    aspect-ratio: 1 / 1;
    margin: 0;
    /* Room above the frame for the participant's crown. */
    margin-top: calc(var(--space-l));
    container-type: size;
  }

  .hero__window {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-fill-on-dark);
  }

  /* Cover-fit the stage to the frame, anchored to the top edge and the participant. */
  .hero__stage {
    --h: max(100cqh, 100cqw / var(--stage-ar));
    --w: calc(var(--h) * var(--stage-ar));
    position: absolute;
    top: 0;
    left: clamp(100cqw - var(--w), 50cqw - var(--w) * var(--stage-anchor-x), 0px);
    width: var(--w);
    height: var(--h);
  }

  .hero__stage :global(picture),
  .hero__photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__photo {
    object-fit: cover;
    transform-origin: calc(var(--stage-anchor-x) * 100%) 0;
  }

  .hero__stage--front {
    pointer-events: none;
  }

  .hero__cutout {
    position: absolute;
    left: var(--front-left);
    top: var(--front-top);
    width: var(--front-width);
    height: auto;
    max-width: none;
  }

  /* Learn, Apply, Connect: words joined by fine yellow lines. */
  .hero__path {
    grid-column: content;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
  }

  .hero__step {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .hero__step:not(:last-child)::after {
    content: '';
    display: block;
    width: clamp(1.5rem, 6vw, 3rem);
    height: 1px;
    margin-inline: var(--space-xs);
    background: var(--color-yellow);
    transform-origin: left center;
  }

  /* ---------- Tablet ---------- */

  @media (min-width: 40rem) {
    .hero__media {
      aspect-ratio: 4 / 3;
    }

    .hero__lede {
      font-size: var(--text-lg);
    }
  }

  /* ---------- Desktop: asymmetric editorial composition ---------- */

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns:
        [full-start] minmax(var(--gutter), 1fr)
        [content-start] minmax(0, calc(var(--width-content) * 0.47))
        [copy-end] minmax(var(--space-xl), calc(var(--width-content) * 0.06))
        [media-start] minmax(0, calc(var(--width-content) * 0.47))
        [content-end] minmax(var(--gutter), 1fr) [full-end];
      grid-template-rows: auto auto;
      row-gap: var(--space-xl);
      --pad-end: clamp(3rem, 1.5rem + 3vw, 5rem);
      /* The top padding leaves room for the crown above the frame. */
      padding-block: clamp(5.5rem, 3rem + 5vw, 8rem) var(--pad-end);
    }

    .hero__eyebrow {
      max-width: none;
    }

    .hero__copy {
      grid-column: content-start / copy-end;
      grid-row: 1;
      justify-content: center;
      container-type: inline-size;
    }

    .hero__title {
      /* Sized to the column so each intentional line fills it without wrapping. */
      font-size: clamp(2.75rem, 10.6cqi, 5rem);
      line-height: 1.04;
    }

    .hero__line {
      display: block;
      overflow: clip;
      /* Keep descenders and the mask travel inside the line box. */
      padding-block-end: 0.08em;
      margin-block-end: -0.08em;
    }

    .hero__line-inner {
      display: inline-block;
      white-space: nowrap;
    }

    .hero__lede {
      max-width: 34rem;
      font-size: var(--text-base);
    }

    .hero__media {
      grid-column: media-start / full-end;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      /* Runs to the hero's lower edge as well as the viewport's right edge. */
      height: calc(100% + var(--pad-end));
      min-height: clamp(34rem, 68vh, 48rem);
      margin-top: 0;
      margin-bottom: calc(-1 * var(--pad-end));
    }

    .hero__path {
      grid-column: content-start / media-start;
      grid-row: 2;
      align-self: end;
    }

    /* The last line runs on to the photograph: the bridge into opportunity. */
    .hero__step:last-child {
      flex: 1 1 auto;
    }

    .hero__step:last-child::after {
      content: '';
      display: block;
      flex: 1 1 auto;
      height: 1px;
      margin-inline-start: var(--space-xs);
      background: var(--color-yellow);
      transform-origin: left center;
    }
  }

  @media (min-width: 80rem) {
    .hero__lede {
      font-size: var(--text-lg);
    }
  }

  /* ---------- Opening sequence (settles in about 1.2s, never blocks reading) ---------- */

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__eyebrow {
      animation: hero-fade 450ms var(--ease-out) both;
    }

    :global(html.js) .hero__title {
      animation: hero-rise 700ms var(--ease-settle) 60ms both;
    }

    :global(html.js) .hero__lede,
    :global(html.js) .hero__actions {
      animation: hero-rise-small 560ms var(--ease-settle) 320ms both;
    }

    :global(html.js) .hero__window {
      animation: hero-open 850ms var(--ease-curtain) 120ms both;
    }

    /* The crown rises out of the frame as the window finishes opening. */
    :global(html.js) .hero__cutout {
      animation: hero-emerge 480ms var(--ease-settle) 850ms both;
    }

    :global(html.js) .hero__step:not(:last-child)::after {
      animation: hero-draw 320ms var(--ease-out) calc(700ms + var(--i) * 140ms) both;
    }

    @media (min-width: 64rem) {
      /* Lines reveal through stationary masks instead of the whole block. */
      :global(html.js) .hero__title {
        animation: none;
      }

      :global(html.js) .hero__line-inner {
        animation: hero-rise 700ms var(--ease-settle) calc(60ms + var(--i) * 80ms) both;
      }

      :global(html.js) .hero__photo {
        animation: hero-scale 900ms var(--ease-settle) 120ms both;
      }

      :global(html.js) .hero__step:last-child::after {
        animation: hero-draw 420ms var(--ease-out) 980ms both;
      }
    }
  }

  /* Photographic layers wait, paused, until the photograph has loaded. */
  :global(html.js) .hero:not([data-photo-ready]) :is(.hero__window, .hero__photo, .hero__cutout) {
    animation-play-state: paused;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @keyframes hero-rise-small {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* The window opens from its centre, revealing the activity behind it. */
  @keyframes hero-open {
    from {
      clip-path: inset(0 50% 0 50%);
    }

    /* Explicit end: inset() cannot interpolate to `none`. */
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-scale {
    from {
      transform: scale(1.04);
    }
  }

  /*
   * Revealed from the frame line upwards: below the line the cutout sits on
   * identical pixels, so only the crown visibly emerges. No translation, so
   * there is never a double edge.
   */
  @keyframes hero-emerge {
    from {
      /* An empty strip on the frame line: nothing floats before the window opens. */
      clip-path: inset(var(--front-line) 0 calc(100% - var(--front-line)) 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
