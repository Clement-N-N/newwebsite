---
/*
 * Homepage, section 2: Why We Exist. "The gap becomes a connection."
 *
 * The headline's two sentences are held apart by a deliberate gap. A fine
 * yellow line runs through that gap, turns, and descends into the response
 * column, ending beside the paragraph that explains what Impact Axis does.
 *
 * Desktop geometry is CSS only: the headline and the response column are
 * subgrids of the section grid, so the line's corner sits exactly on the
 * shared row and column lines at every width.
 *
 * Photograph: GWF Photos / IDT-34.jpg (unedited; cropped by CSS only).
 */
import { Image } from 'astro:assets';
import photo from '../assets/why/idt-34.jpg';

// Headline and paragraphs verbatim from the Website Content document
// (Home Page > Why We Exist). The eyebrow was supplied in the build brief.
const copy = {
  eyebrow: 'WHY WE EXIST',
  first: 'Young Cameroonians are completing school.',
  secondLead: 'Too many still lack a clear path to',
  secondMark: 'meaningful work.',
  problem:
    'Education provides knowledge, but moving into work also requires practical skills, relevant experience, guidance and professional networks. Too many young people are left to build these alone, making access to opportunity slower and more unequal.',
  response:
    'Impact Axis exists to close this gap by helping young people turn their education and potential into the capabilities, experience and connections needed for meaningful work.',
};

const photoAlt =
  'Four Goodwill Fellowship participants in 2026 GWF T-shirts lean over shared worksheets at a table, writing and discussing together.';
---

<section id="why-we-exist" class="why" aria-labelledby="why-title" data-reveal>
  <p class="why__eyebrow why__fade">{copy.eyebrow}</p>

  <h2 id="why-title" class="why__title">
    <span class="why__first why__fade">{copy.first}</span>
    <span class="why__gap" aria-hidden="true"><span class="why__line why__line--across"></span></span>
    <span class="why__second">
      <span class="why__second-inner">
        {copy.secondLead} <span class="why__mark">{copy.secondMark}</span>
      </span>
    </span>
  </h2>

  <figure class="why__media">
    <Image
      src={photo}
      alt={photoAlt}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="(min-width: 64rem) 58vw, 100vw"
      loading="lazy"
      decoding="async"
      class="why__photo"
    />
  </figure>

  <div class="why__response">
    <span class="why__line why__line--down" aria-hidden="true"></span>
    <p class="why__problem why__fade">{copy.problem}</p>
    <p class="why__answer why__fade">
      <span class="why__node" aria-hidden="true"></span>
      {copy.response}
    </p>
  </div>
</section>

<style>
  .why {
    --gap-h: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    --line: 2px;
    --bleed: max(var(--gutter), calc((100cqw - var(--width-content)) / 2));

    container-type: inline-size;
    position: relative;
    overflow: clip;
    padding-block: var(--space-section);
    background: var(--color-white);
    color: var(--color-ink);
  }

  /* ---------- Mobile first: a single, deliberate column ---------- */

  .why {
    display: grid;
    grid-template-columns: [full-start] var(--gutter) [text-start resp-start] minmax(0, 1fr) [photo-end end] var(--gutter) [full-end];
    align-content: start;
  }

  .why__eyebrow,
  .why__title,
  .why__response {
    grid-column: text-start / end;
  }

  .why__eyebrow {
    color: var(--color-navy);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    line-height: 1.5;
  }

  .why__title {
    display: grid;
    margin-top: var(--space-m);
    color: var(--color-navy);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .why__first,
  .why__second {
    display: block;
  }

  /* The first sentence states a fact, quietly. */
  .why__first {
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 3.25rem);
    font-weight: var(--weight-regular);
    line-height: 1.15;
  }

  /* The second carries the weight of the message. */
  .why__second {
    font-size: clamp(2rem, 1.25rem + 3.4vw, 4.5rem);
    line-height: 1.04;
    /* Mask for the upward reveal; padding keeps descenders inside it. */
    overflow: clip;
    padding-block-end: 0.12em;
    margin-block-end: -0.12em;
  }

  .why__second-inner {
    display: block;
  }

  .why__mark {
    background: linear-gradient(var(--color-yellow), var(--color-yellow)) 0 92% / 100% 0.1em no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* The deliberate gap between the sentences. */
  .why__gap {
    display: block;
    height: var(--gap-h);
  }

  .why__line {
    display: block;
    background: var(--color-yellow);
  }

  /* On narrow screens the across-line and the long drop are not used. */
  .why__line--across,
  .why__line--down {
    display: none;
  }

  .why__media {
    grid-column: full-start / full-end;
    margin: var(--space-xl) 0 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .why__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 40%;
  }

  .why__response {
    margin-top: var(--space-xl);
    min-width: 0;
  }

  .why__problem {
    max-width: 38rem;
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .why__answer {
    position: relative;
    max-width: 38rem;
    color: var(--color-navy);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: 1.55;
  }

  /* Mobile: a short vertical accent joins the two paragraphs. */
  .why__node {
    display: block;
    width: var(--line);
    height: var(--space-2xl);
    margin-block: var(--space-m);
    background: var(--color-yellow);
    transform-origin: top center;
  }

  @media (min-width: 40rem) {
    .why__media {
      grid-column: full-start / end;
      aspect-ratio: 3 / 2;
    }
  }

  /* ---------- Desktop: the connected editorial composition ---------- */

  @media (min-width: 64rem) {
    .why {
      grid-template-columns:
        [full-start] var(--bleed)
        [text-start] minmax(0, 56fr)
        [photo-end] minmax(0, 6fr)
        [resp-start] minmax(0, 38fr)
        [end] var(--bleed) [full-end];
      grid-template-rows: [eyebrow] auto [first] auto [gap] var(--gap-h) [second] auto [media-a] auto [media-b] auto [media-end];
    }

    .why__eyebrow {
      grid-row: eyebrow;
    }

    .why__title {
      grid-column: text-start / end;
      grid-row: first / media-a;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      margin-top: var(--space-l);
    }

    .why__first {
      grid-column: 1 / -1;
      grid-row: 1;
      align-self: end;
    }

    /* Both sentences sit tight against the gap, so it reads as one deliberate pause. */
    .why__second {
      align-self: start;
    }

    .why__gap {
      grid-column: 1 / 3; /* text-start to resp-start */
      grid-row: 2;
      height: auto;
      display: flex;
      align-items: center;
    }

    .why__line--across {
      display: block;
      width: 100%;
      height: var(--line);
      transform-origin: left center;
    }

    .why__second {
      grid-column: 1 / 2; /* text-start to photo-end: clear of the line's descent */
      grid-row: 3;
    }

    .why__media {
      grid-column: full-start / photo-end;
      grid-row: media-a / media-end;
      aspect-ratio: 3 / 2;
      margin-top: var(--space-2xl);
    }

    .why__photo {
      object-position: 50% 35%;
    }

    .why__response {
      grid-column: resp-start / end;
      grid-row: gap / media-end;
      display: grid;
      grid-template-rows: subgrid;
      grid-template-columns: var(--line) var(--space-l) minmax(0, 1fr);
      margin-top: 0;
    }

    /* Descends from the gap's centre to the response paragraph. */
    .why__line--down {
      display: block;
      grid-column: 1;
      grid-row: 1 / 3; /* gap and second-sentence rows, beside the first paragraph */
      width: var(--line);
      margin-top: calc(var(--gap-h) / 2 - var(--line) / 2);
      transform-origin: top center;
    }

    /* The problem starts level with the second sentence's cap line. */
    .why__problem {
      grid-column: 3;
      grid-row: 2;
      align-self: start;
      /* Pulls the smaller text's first line onto the headline's cap line. */
      margin-top: -0.6rem;
    }

    /* The response sits beside the photograph, where the line arrives. */
    .why__answer {
      /* Matches the photograph's top margin, so the response starts level with it. */
      --answer-pad: calc(var(--space-2xl) - 0.9rem);
      grid-column: 3;
      grid-row: 3 / span 2;
      padding-top: var(--answer-pad);
      font-size: var(--text-lg);
      line-height: 1.5;
    }

    /* The line continues into the response and ends level with its first line. */
    .why__node {
      position: absolute;
      top: 0;
      left: calc(-1 * var(--space-l) - var(--line));
      width: var(--line);
      height: calc(var(--answer-pad) + 0.72em);
      margin: 0;
      transform-origin: top center;
    }

    .why__node::after {
      content: '';
      position: absolute;
      bottom: calc(var(--line) * -2);
      left: calc(var(--line) * -2);
      width: calc(var(--line) * 5);
      height: calc(var(--line) * 5);
      border-radius: 50%;
      background: var(--color-yellow);
    }
  }

  @media (min-width: 80rem) {
    .why__problem {
      font-size: var(--text-lg);
    }

    .why__answer {
      font-size: var(--text-xl);
      line-height: 1.45;
    }
  }

  /* ---------- Scroll moment: runs once, never required to read ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .why .why__fade,
    .why .why__second-inner {
      transition:
        opacity 600ms var(--ease-settle),
        transform 600ms var(--ease-settle);
    }

    .why .why__media {
      transition: clip-path 900ms var(--ease-curtain) 250ms;
    }

    .why .why__line--across {
      transition: transform 480ms var(--ease-out) 380ms;
    }

    .why .why__line--down {
      transition: transform 420ms var(--ease-out) 840ms;
    }

    .why .why__node {
      transition: transform 360ms var(--ease-settle) 700ms;
    }

    .why .why__second-inner {
      transition-delay: 160ms;
    }

    .why .why__problem {
      transition-delay: 420ms;
    }

    .why .why__answer {
      transition-delay: 640ms;
    }

    @media (min-width: 64rem) {
      .why .why__node {
        transition-duration: 240ms;
        transition-delay: 1240ms;
      }
    }

    /* Hidden states apply only after the script has marked the section. */
    .why[data-reveal='pending'] .why__fade {
      opacity: 0;
      transform: translateY(20px);
    }

    .why[data-reveal='pending'] .why__second-inner {
      opacity: 0;
      transform: translateY(22px);
    }

    .why[data-reveal='pending'] .why__media {
      clip-path: inset(0 0 100% 0);
    }

    .why[data-reveal='pending'] .why__line--across {
      transform: scaleX(0);
    }

    .why[data-reveal='pending'] .why__line--down,
    .why[data-reveal='pending'] .why__node {
      transform: scaleY(0);
    }


    .why .why__media {
      clip-path: inset(0 0 0 0);
    }
  }
</style>

<script>
  // Reveal once when the section enters the viewport. Content is only hidden
  // after this script runs, so it stays visible if scripting is unavailable.
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (motionOk && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.dataset.reveal = 'in';
          observer.unobserve(el);
        }
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
    );

    document.querySelectorAll<HTMLElement>('.why[data-reveal]').forEach((section) => {
      section.dataset.reveal = 'pending';
      observer.observe(section);
    });
  }
</script>
