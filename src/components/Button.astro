---
import type { HTMLAttributes } from 'astro/types';

type Common = {
  /** `outline-light` is for dark (navy) surfaces. */
  variant?: 'primary' | 'outline-light';
  size?: 'default' | 'large';
  block?: boolean;
  /** Adds a decorative trailing arrow that nudges forward on hover and focus. */
  arrow?: boolean;
  class?: string;
};

type LinkProps = Common & Omit<HTMLAttributes<'a'>, 'class'> & { href: string };
type ButtonProps = Common & Omit<HTMLAttributes<'button'>, 'class'> & { href?: never };

type Props = LinkProps | ButtonProps;

const {
  variant = 'primary',
  size = 'default',
  block = false,
  arrow = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['button', `button--${variant}`, `button--${size}`, block && 'button--block', className];
---

{
  'href' in rest && rest.href ? (
    <a class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button type="button" class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    border: 0;
    border-radius: var(--radius-xs);
    font-size: var(--text-nav);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .button--large {
    min-height: 3.25rem;
    padding: 0.875rem 1.5rem;
    font-size: var(--text-base);
  }

  .button--block {
    display: flex;
    width: 100%;
  }

  .button--primary {
    background-color: var(--color-yellow);
    color: var(--color-navy);
  }

  .button--primary:hover {
    background-color: var(--color-yellow-hover);
  }

  .button--primary:active {
    background-color: var(--color-yellow-hover);
  }

  /* Outline for navy surfaces: white text and hairline, filling faintly on hover. */
  .button--outline-light {
    background-color: transparent;
    color: var(--color-white);
    box-shadow: inset 0 0 0 var(--border-thin) var(--color-outline-on-dark);
    --focus-color: var(--color-yellow);
  }

  .button--outline-light:hover {
    background-color: var(--color-fill-on-dark);
    box-shadow: inset 0 0 0 var(--border-thin) var(--color-white);
  }

  .button__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .button:hover .button__arrow,
  .button:focus-visible .button__arrow {
    transform: translateX(0.25rem);
  }
</style>
